{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.py": {
      "includeFiles": "lostfound.db"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path=/api/$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.py?__path=/api"
    },
    {
      "source": "/web/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/web",
      "destination": "/index.html"
    }
  ]
}
